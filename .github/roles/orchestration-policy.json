{
  "version": "1.1",
  "description": "Canonical machine-readable policy for the supervisor orchestration overlay: delegation depth, specialist allow-list, task routing, write-set discipline, and high-risk approval boundaries.",
  "appliesTo": "overlay-supervisor-orchestration",
  "canonical": true,
  "singleSourceOfTruth": true,
  "delegationDepth": {
    "maxLevels": 1,
    "nestedDelegationEnabled": false,
    "onlySupervisorMayDelegate": true,
    "workersMayDelegate": false,
    "supervisorRole": "orchestration",
    "capability": "delegate-agent",
    "hostAdapters": {
      "vscode-copilot": {
        "delegationTools": ["agent", "runSubagent"],
        "note": "Verified against VS Code documentation on 2026-09-14: the subagents guide requires the `runSubagent` or `agent` tool in `tools`, and the custom-agents guide documents the `agents` allow-list paired with the `agent` tool."
      },
      "github-copilot": {
        "delegationTools": ["agent"],
        "note": "Verified against the GitHub Copilot custom-agents configuration reference on 2026-09-14: the `agent` tool alias invokes another custom agent; compatible aliases are `custom-agent` and `Task`."
      }
    }
  },
  "specialistAllowList": [
    "analyst",
    "tech-planner",
    "architecture-reviewer",
    "senior-software-engineer",
    "code-reviewer",
    "security-reviewer",
    "qa",
    "tdd-vitest",
    "documentation-maintainer"
  ],
  "approvalRequiredCategories": [
    {
      "id": "architecture-change",
      "description": "Changes to architectural layers, boundaries, public contracts, or module shape."
    },
    {
      "id": "core-governance-change",
      "description": "Changes to starter or repository governance assets such as AGENTS.md, tool-access.json, agent policy, module composition, validators, or architecture contracts."
    },
    {
      "id": "dependency-change",
      "description": "Adding, removing, or materially changing a dependency, framework, runtime, build tool, or infrastructure component."
    },
    {
      "id": "destructive-data-change",
      "description": "Database or schema migrations, data transformations, or any change that can destroy or irreversibly rewrite data."
    },
    {
      "id": "identity-security-change",
      "description": "Changes to authentication, authorization, secrets, permissions, identity, security controls, or trust boundaries."
    },
    {
      "id": "production-or-deployment-change",
      "description": "Changes to deployment, production infrastructure, networking, CI/CD, release behavior, or runtime configuration."
    },
    {
      "id": "destructive-operation",
      "description": "Commands or operations that delete, prune, force-reset, overwrite history, or otherwise destroy state."
    },
    {
      "id": "scope-expansion",
      "description": "Work that grows beyond the requested slice or the declared write set."
    }
  ],
  "retryPolicy": {
    "maxRepairAttempts": 3,
    "identicalFailureThreshold": 2,
    "maxVerifyRetries": 1,
    "maxWallClockMinutes": 120,
    "escalateOnIdenticalFailure": true,
    "escalateOnBudgetExhausted": true,
    "inconclusiveIsNeverSuccess": true,
    "stateLocation": ".agentic/state/<run-id>.json",
    "failureSignature": "hash of sorted failing check names and messages, or an explicit failureSignature",
    "engine": ".github/scripts/agentic_engine.py",
    "note": "The engine enforces this policy deterministically. A run stops on VERIFIED, an identical failure signature, an exhausted attempt budget, or INCONCLUSIVE after the allowed retries; it never loops forever."
  },
  "complexityRouting": {
    "defaultWhenUncertain": "complex",
    "complexIfAny": [
      "Changes more than one architectural layer or independently owned subsystem.",
      "Requires an architecture or public-contract decision.",
      "Adds, removes, or materially changes a dependency, framework, runtime, build tool, or infrastructure component.",
      "Requires a database or schema migration or a data transformation.",
      "Changes authentication, authorization, secrets, permissions, identity, security controls, or trust boundaries.",
      "Changes deployment, production infrastructure, networking, CI/CD, release behavior, or runtime configuration.",
      "Modifies starter or core governance assets such as AGENTS.md, tool-access.json, agent policy, module composition, validators, or architecture contracts.",
      "Contains multiple independent implementation workstreams.",
      "Has incomplete, conflicting, or design-dependent acceptance criteria.",
      "Crosses a mandatory human-approval boundary.",
      "Cannot be bounded to a sufficiently narrow implementation scope or write set."
    ],
    "notBasedOn": [
      "file count",
      "prompt size",
      "token count"
    ],
    "simpleWorkflow": "delegation-supervisor -> implementer -> appropriate validation/review",
    "complexWorkflow": "delegation-supervisor -> parallel read-only analysis -> consolidated plan -> human approval when required -> engine loop (implement -> verify -> repair until verified, an identical failure repeats, or the attempt budget is exhausted) -> parallel independent review -> engine completion"
  },
  "taskClasses": [
    { "id": "QUESTION", "description": "Answer a question about the codebase or workflow without changing files." },
    { "id": "INVESTIGATION", "description": "Investigate a symptom or area and report findings with root-cause hypotheses." },
    { "id": "BUG_FIX", "description": "Reproduce, root-cause, and fix a localized defect with regression coverage." },
    { "id": "FEATURE", "description": "Add a new capability through understand, plan, implement, and verify." },
    { "id": "REFACTOR", "description": "Restructure existing behavior without changing observable contracts." },
    { "id": "ARCHITECTURE", "description": "Change layers, boundaries, or public contracts." },
    { "id": "SECURITY", "description": "Change authentication, authorization, secrets, permissions, or trust boundaries." },
    { "id": "PERFORMANCE", "description": "Improve measured resource behavior against a stated budget." },
    { "id": "TESTING", "description": "Add or repair tests or the test harness itself." },
    { "id": "DOCUMENTATION", "description": "Update docs, runbooks, ADRs, and changelogs." },
    { "id": "MIGRATION", "description": "Move data, schema, dependencies, or platforms." },
    { "id": "INFRASTRUCTURE", "description": "Change deployment, CI/CD, or runtime configuration." },
    { "id": "UNKNOWN_COMPLEX", "description": "A problem that needs decomposition before a playbook can be selected." }
  ],
  "playbooks": {
    "QUESTION": [
      { "id": "understand", "name": "Understand the question", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "answer", "name": "Produce the answer", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "INVESTIGATION": [
      { "id": "investigate", "name": "Gather evidence", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "report", "name": "Report findings and hypotheses", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "BUG_FIX": [
      { "id": "reproduce", "name": "Reproduce the failure", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "investigate", "name": "Investigate the failure", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "root-cause", "name": "Confirm the root cause", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "implement", "name": "Implement the fix", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "test", "name": "Test and add regression coverage", "delegatesTo": ["senior-software-engineer", "tdd-vitest"], "skipRequiresReason": true },
      { "id": "verify-real-behavior", "name": "Verify real behavior", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "FEATURE": [
      { "id": "understand", "name": "Understand the request", "delegatesTo": ["analyst", "tech-planner"], "skipRequiresReason": true },
      { "id": "plan", "name": "Plan the feature", "delegatesTo": ["tech-planner"], "skipRequiresReason": true },
      { "id": "implement", "name": "Implement the feature", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "test", "name": "Test the feature", "delegatesTo": ["senior-software-engineer", "tdd-vitest"], "skipRequiresReason": true },
      { "id": "verify", "name": "Verify against the success predicate", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer", "architecture-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "REFACTOR": [
      { "id": "understand", "name": "Understand the current behavior", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "plan", "name": "Plan the refactor", "delegatesTo": ["tech-planner"], "skipRequiresReason": true },
      { "id": "implement", "name": "Restructure the code", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "test", "name": "Test unchanged contracts", "delegatesTo": ["senior-software-engineer", "tdd-vitest"], "skipRequiresReason": true },
      { "id": "verify", "name": "Verify observable behavior", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer", "architecture-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "ARCHITECTURE": [
      { "id": "investigate", "name": "Investigate the problem", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "design", "name": "Design the change", "delegatesTo": ["architecture-reviewer"], "skipRequiresReason": true },
      { "id": "record-adr", "name": "Record the decision", "delegatesTo": ["architecture-reviewer"], "skipRequiresReason": true },
      { "id": "approve", "name": "Human approval checkpoint", "requiresHumanApproval": true, "delegatesTo": [], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "SECURITY": [
      { "id": "investigate", "name": "Investigate the security surface", "delegatesTo": ["security-reviewer"], "skipRequiresReason": true },
      { "id": "assess", "name": "Assess risk and mitigations", "delegatesTo": ["security-reviewer"], "skipRequiresReason": true },
      { "id": "approve", "name": "Human approval checkpoint", "requiresHumanApproval": true, "delegatesTo": [], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "PERFORMANCE": [
      { "id": "measure-baseline", "name": "Measure the baseline", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "triage", "name": "Classify the bottleneck", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "implement", "name": "Implement the smallest fix", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "re-measure", "name": "Re-measure with the same method", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "TESTING": [
      { "id": "plan", "name": "Plan the test change", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "implement", "name": "Implement the tests", "delegatesTo": ["tdd-vitest"], "skipRequiresReason": true },
      { "id": "run", "name": "Run the tests", "delegatesTo": ["tdd-vitest"], "skipRequiresReason": true },
      { "id": "review", "name": "Review coverage and quality", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "DOCUMENTATION": [
      { "id": "update", "name": "Update the documentation", "delegatesTo": ["documentation-maintainer"], "skipRequiresReason": true },
      { "id": "review", "name": "Review doc alignment", "delegatesTo": ["documentation-maintainer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "MIGRATION": [
      { "id": "plan", "name": "Plan the migration", "delegatesTo": ["tech-planner"], "skipRequiresReason": true },
      { "id": "approve", "name": "Human approval checkpoint", "requiresHumanApproval": true, "delegatesTo": [], "skipRequiresReason": true },
      { "id": "execute", "name": "Execute the migration", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "verify", "name": "Verify the migration", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "INFRASTRUCTURE": [
      { "id": "plan", "name": "Plan the change", "delegatesTo": ["tech-planner"], "skipRequiresReason": true },
      { "id": "approve", "name": "Human approval checkpoint", "requiresHumanApproval": true, "delegatesTo": [], "skipRequiresReason": true },
      { "id": "execute", "name": "Execute the change", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "verify", "name": "Verify the change", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ],
    "UNKNOWN_COMPLEX": [
      { "id": "investigate", "name": "Investigate the problem", "delegatesTo": ["analyst"], "skipRequiresReason": true },
      { "id": "design-playbook", "name": "Design the playbook", "delegatesTo": ["tech-planner"], "skipRequiresReason": true },
      { "id": "execute", "name": "Execute the work", "delegatesTo": ["senior-software-engineer"], "skipRequiresReason": true },
      { "id": "verify", "name": "Verify the outcome", "delegatesTo": ["qa"], "skipRequiresReason": true },
      { "id": "review", "name": "Review the change", "delegatesTo": ["code-reviewer"], "skipRequiresReason": true },
      { "id": "complete", "name": "Declare completion", "delegatesTo": ["delegation-supervisor"], "skipRequiresReason": true }
    ]
  },
  "evidenceRequirements": {
    "resultVocabulary": ["VERIFIED", "NOT_VERIFIED", "INCONCLUSIVE"],
    "inconclusiveNeverSuccess": true,
    "completionRule": "orchestrator-declared-after-verification-evidence",
    "surfaces": {
      "ui": {
        "evidence": ["run-the-real-ui", "interact-with-the-changed-behavior", "inspect-resulting-state", "capture-screenshot-or-browser-evidence-when-supported"]
      },
      "api": {
        "evidence": ["execute-the-endpoint", "verify-status", "verify-response", "exercise-important-negative-cases"]
      },
      "database": {
        "evidence": ["apply-migration-to-disposable-data", "insert-or-migrate", "read-back-resulting-state", "verify-schema-and-data-constraints"]
      },
      "cli": {
        "evidence": ["run-the-command", "inspect-exit-code", "inspect-stdout-stderr", "exercise-dry-run-and-error-behavior"]
      },
      "configuration": {
        "evidence": ["load-with-the-real-parser", "read-resulting-values-back"]
      },
      "library": {
        "evidence": ["test-the-public-interface", "validate-behavior-through-callers"]
      }
    }
  },
  "writeSet": {
    "requiredBeforeWriteDelegation": true,
    "parallelWriteDelegation": "declared-disjoint-sets-only",
    "unboundedDeclarationOutcome": "serialize",
    "unboundedIndicators": [
      "unknown",
      "broad",
      "wildcard-only",
      "tbd",
      "not-safely-bounded"
    ],
    "readOnlyParallelAllowed": true,
    "overlappingFilesConcurrent": false
  },
  "enforcement": {
    "level": "prompt-contract",
    "runtimeEnforced": false,
    "note": "This policy is a governance expectation and a behavioral contract. No repository hook validates agent-to-agent delegation, and no trusted identity source or enforcement point exists for these approvals. Documentation must not describe this gate as enforced authorization."
  },
  "approvalOverlayComposition": {
    "hardDependency": false,
    "requiresOverlayApprovalGatedOrchestration": false,
    "whenBothEnabled": "reuse the approval-gated transition envelope rather than defining a second approval experience",
    "whenApprovalOverlayAbsent": "the supervisor still stops at the mandatory high-risk checkpoint"
  },
  "fallbackWhenDelegationUnavailable": {
    "mode": "guided-delegation-plan",
    "silentDegradationAllowed": false,
    "planFields": [
      "targetAgent",
      "objective",
      "context",
      "writeSet",
      "acceptanceCriteria",
      "expectedReturnFormat",
      "executionOrder"
    ],
    "note": "If the runtime cannot delegate subagents, the supervisor emits an ordered plan for the user to execute or refuses the delegation. It must not pretend delegation occurred."
  },
  "deferredProposal": {
    "id": "option-c-core-high-risk-gate",
    "status": "deferred-not-rejected",
    "description": "Move a universal minimum high-risk approval contract into core governance so guided and supervisor workflows inherit it. Requires its own ADR and must not be bundled into the supervisor overlay."
  }
}
