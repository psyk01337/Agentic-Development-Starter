{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-development-starter/delegation-result.schema.json",
  "title": "Supervisor Delegation Result",
  "description": "Bounded return contract a delegated specialist agent hands back to the supervisor for one assigned slice. It is a communication contract, not proof: the supervisor and verification agents must inspect the underlying artifacts before completion. The result status records the delegated work's own outcome; only the orchestrator may declare the task complete, and only after verification evidence satisfies the success predicate (INCONCLUSIVE never counts as success).",
  "type": "object",
  "additionalProperties": false,
  "required": ["resultVersion", "agent", "task", "status", "summary", "filesChanged", "assumptions", "risks", "verificationPerformed", "evidence", "openQuestions", "recommendedNextAction"],
  "properties": {
    "resultVersion": {
      "type": "string",
      "const": "1.0"
    },
    "agent": {
      "type": "string",
      "enum": [
        "analyst",
        "tech-planner",
        "architecture-reviewer",
        "senior-software-engineer",
        "code-reviewer",
        "security-reviewer",
        "qa",
        "tdd-vitest",
        "documentation-maintainer"
      ]
    },
    "task": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["completed", "partial", "blocked", "failed"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "filesChanged": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verificationPerformed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "method", "result", "evidenceReference"],
        "properties": {
          "surface": {
            "type": "string",
            "enum": ["ui", "api", "database", "cli", "configuration", "library"]
          },
          "method": { "type": "string", "minLength": 1 },
          "result": {
            "type": "string",
            "enum": ["VERIFIED", "NOT_VERIFIED", "INCONCLUSIVE"]
          },
          "evidenceReference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "openQuestions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "recommendedNextAction": {
      "type": "string",
      "enum": ["VERIFY", "REVIEW", "REPAIR", "ESCALATE", "NONE"]
    }
  }
}