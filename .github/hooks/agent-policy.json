{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/session-banner.sh",
        "powershell": "pwsh -NoProfile -File .github/hooks/scripts/session-banner.ps1",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/pre-tool-policy.sh",
        "powershell": "pwsh -NoProfile -File .github/hooks/scripts/pre-tool-policy.ps1",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash .github/hooks/scripts/audit-log.sh",
        "powershell": "pwsh -NoProfile -File .github/hooks/scripts/audit-log.ps1",
        "timeoutSec": 10
      }
    ]
  }
}
